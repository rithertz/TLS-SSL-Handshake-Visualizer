+
+        {/* ------------------------------------------------------------
+            6. Method
+            ------------------------------------------------------------ */}
+        <section className="sb-section" aria-labelledby="sb-method-title">
+          <h3 id="sb-method-title" className="sb-section-title">
+            <span className="sb-step">{whatIfs.length > 0 ? 6 : 5}</span> How the scoring model works
+          </h3>
+
+          <div className="sb-method-grid">
+            <div className="sb-method-item">
+              <h4>Penalty-based</h4>
+              <p>
+                Every scan starts at 100. Each rule that does not fully pass subtracts a fixed
+                number of points. The result is clamped to 0–100, then mapped to a letter grade.
+              </p>
+            </div>
+            <div className="sb-method-item">
+              <h4>Deterministic</h4>
+              <p>
+                The same inputs always give the same score, grade, findings and recommendations. No
+                randomness and no external calls; only certificate dates are compared against the
