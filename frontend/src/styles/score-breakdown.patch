+                          <span className={`badge ${statusBadgeClass(finding.status)}`}>
+                            {finding.status}
+                          </span>
+                          <span className={`sb-rule-cost font-mono ${cost > 0 ? "sb-neg" : ""}`}>
+                            {matchedTier ? minus(cost) : "n/a"}
+                          </span>
+                        </>
+                      ) : (
+                        <span className="badge badge-neutral">NO FINDING</span>
+                      )}
+                    </span>
+                  </summary>
+
+                  <div className="sb-rule-body">
+                    <dl className="sb-dl">
+                      <dt>What it checks</dt>
+                      <dd>{rule.checks}</dd>
+                      <dt>Why it matters</dt>
+                      <dd>{rule.whyItMatters}</dd>
+                    </dl>
+
+                    <table className="sb-table sb-tier-table">
+                      <thead>
+                        <tr>
+                          <th scope="col">Possible outcome</th>
+                          <th scope="col">Status</th>
+                          <th scope="col">Severity</th>
+                          <th scope="col" className="sb-num">
+                            Penalty
+                          </th>
+                        </tr>
+                      </thead>
+                      <tbody>
+                        {rule.tiers.map((tier) => {
+                          const isApplied = matchedTier === tier;
+                          return (
+                            <tr
+                              key={tier.condition}
+                              className={isApplied ? "sb-tier-applied" : ""}
+                              aria-current={isApplied ? "true" : undefined}
