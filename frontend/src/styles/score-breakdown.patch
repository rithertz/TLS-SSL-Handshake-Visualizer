+
+.sb-mini-score {
+  font-size: 1.35rem;
+  font-weight: 700;
+  color: var(--text-main);
+}
+
+.sb-mini-total {
+  font-size: 0.8rem;
+  color: var(--text-dim);
+  font-weight: 500;
+}
+
+.sb-body {
+  display: flex;
+  flex-direction: column;
+  gap: 2rem;
+}
+
+/* ---- Sections ---- */
+
+.sb-section {
+  display: flex;
+  flex-direction: column;
+  gap: 0.9rem;
+  padding-bottom: 1.75rem;
+  border-bottom: 1px dashed var(--border-color);
+}
+
+.sb-section:last-child {
+  border-bottom: none;
+  padding-bottom: 0;
+}
+
+.sb-section-title {
