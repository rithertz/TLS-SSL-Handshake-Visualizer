+                  <summary className="sb-rule-summary">
+                    <span className="rule-id-tag font-mono">{rule.id}</span>
+                    <span className="sb-rule-name">{rule.name}</span>
+                    <span className="sb-rule-outcome">
+                      {finding ? (
